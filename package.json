{
  "author": "Sadique Sadiq",
  "build": {
    "appId": "com.sadique.iptv.desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ffmpeg-bin",
        "to": "ffmpeg-bin"
      }
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ]
    },
    "portable": {
      "artifactName": "IPTV-Desktop-portable.exe"
    },
    "productName": "IPTV Desktop",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "dir"
      ]
    },
    "compression": "maximum",
    "afterPack": "scripts/after-pack.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "hls.js": "1.7.4",
    "mpegts.js": "1.8.2"
  },
  "description": "IPTV Desktop — Live TV, movies and series on Windows (Linux later), same TV style as the Android app.",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "license": "UNLICENSED",
  "main": "src/main.js",
  "name": "iptv-desktop",
  "private": true,
  "scripts": {
    "build:linux": "node scripts/prepare-ffmpeg.js linux && electron-builder --linux dir",
    "build:win": "node scripts/prepare-ffmpeg.js win && electron-builder --win portable dir",
    "build:win-dir": "node scripts/prepare-ffmpeg.js win && electron-builder --win dir",
    "start": "electron ."
  },
  "version": "1.0.3"
}
