{
  "author": "Sadique Sadiq",
  "build": {
    "appId": "com.sadique.iptv.desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir"
      ]
    },
    "portable": {
      "artifactName": "IPTV-Desktop-portable.exe"
    },
    "productName": "IPTV Desktop",
    "win": {
      "target": [
        "portable",
        "dir"
      ]
    }
  },
  "dependencies": {
    "hls.js": "1.7.4",
    "mpegts.js": "1.8.2"
  },
  "description": "IPTV Desktop — Live TV, movies and series on Windows (Linux later), same TV style as the Android app.",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "license": "UNLICENSED",
  "main": "src/main.js",
  "name": "iptv-desktop",
  "private": true,
  "scripts": {
    "build:linux": "electron-builder --linux dir",
    "build:win": "electron-builder --win portable dir",
    "build:win-dir": "electron-builder --win dir",
    "start": "electron ."
  },
  "version": "1.0.0"
}
