{
  "author": "Sadique Sadiq",
  "build": {
    "appId": "com.sadique.iptv.desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "docs/third-party-notices.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ffmpeg-bin",
        "to": "ffmpeg-bin"
      }
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "artifactName": "IPTV-Desktop-Setup-${version}.${ext}",
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IPTV Desktop",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "productName": "IPTV Desktop",
    "publish": {
      "provider": "github",
      "owner": "sadique6571",
      "repo": "IPTV-PC"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "forceCodeSigning": true,
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"]
      }
    },
    "compression": "maximum",
    "afterPack": "scripts/after-pack.js"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "description": "IPTV Desktop — Live TV, movies and series on Windows (Linux later), same TV style as the Android app.",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "ffmpeg-static": "5.3.0",
    "js-yaml": "4.3.2"
  },
  "license": "MIT",
  "main": "src/main.js",
  "name": "iptv-desktop",
  "private": true,
  "repository": "github:sadique6571/IPTV-PC",
  "scripts": {
    "build:linux": "node scripts/prepare-ffmpeg.js linux && electron-builder --linux dir",
    "build:win": "node scripts/build-win.js",
    "start": "electron ."
  },
  "version": "1.0.14"
}
